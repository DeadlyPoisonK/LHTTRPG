{{!-- One change row: core's change.hbs plus the destination label / warnings below the key (effect-config.mjs). --}}
<li data-index="{{index}}">
    {{#if changeType}}
    <div class="key">
        {{formInput fields.key name=change.keyPath value=change.key}}
        <div class="lh-effect-target-info" data-index="{{index}}">
            {{#if info.warning}}
            <span class="lh-target-warning {{info.status}}" data-tooltip="{{info.message}}">
                <i class="fa-solid fa-triangle-exclamation"></i> {{info.message}}
            </span>
            {{else if info.label}}
            <span class="lh-target-label">{{info.label}}</span>
            {{#if info.chip}}
            <span class="lh-target-chip {{info.chip.type}}">[{{info.chip.label}}]</span>
            {{/if}}
            {{/if}}
        </div>
    </div>
    <div class="type">
        {{formInput fields.type name=change.typePath value=change.type choices=changeTypes}}
    </div>
    <div class="value">
        {{formInput fields.value name=change.valuePath value=change.value elementType="input"}}
    </div>
    <input type="hidden" name="{{change.phasePath}}" value="{{change.phase}}">
    {{else}}
    <div class="unregistered notification warning">
        {{localize "EFFECT.CHANGES.Unregistered" type=change.type}}
    </div>
    {{/if}}

    <div class="priority">
        {{formInput fields.priority name=change.priorityPath value=change.priority placeholder=defaultPriority
                    disabled=(not changeType)}}
    </div>
    <div class="controls">
        <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteChange"></button>
    </div>
</li>
